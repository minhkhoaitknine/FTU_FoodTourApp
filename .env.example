# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Database
# Use a local PostgreSQL database for development, or Supabase/Neon for deployment.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/foodtour?schema=public"

# Auth
# Replace this in real deployments. Development only.
AUTH_SECRET="change-this-development-secret"

# Optional map/routing providers
OPENROUTESERVICE_API_KEY=""
ENABLE_EXTERNAL_ROUTING=false

