# Application
NEXT_PUBLIC_APP_URL="https://your-public-app-url.example"
NODE_ENV="production"

# Database
# Use a managed PostgreSQL connection string from Neon, Supabase, Railway or another provider.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Auth
# Generate a long random value before deployment.
AUTH_SECRET="replace-with-a-long-random-production-secret"

# Optional map/routing providers
OPENROUTESERVICE_API_KEY=""
ENABLE_EXTERNAL_ROUTING=false
